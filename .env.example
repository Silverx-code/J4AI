# --- Database (PostgreSQL: Neon, Supabase, or local) ---
DATABASE_URL=postgresql://user:password@localhost:5432/j4ai

# --- Auth.js (next-auth v4) ---
NEXTAUTH_URL=http://localhost:3000
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me

# --- First admin account (created by `npm run db:seed`) ---
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=J4AI Admin

# --- Email (optional; without it, notifications are logged to the server console) ---
RESEND_API_KEY=
EMAIL_FROM="J4AI <no-reply@yourdomain.org>"
ADMIN_NOTIFY_EMAIL=jesusforallinitiative@gmail.com

# --- File uploads (optional; without Cloudinary files are stored in /public/uploads, dev/self-host only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
